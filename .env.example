# =============================================================================
# Copy to .env.local for development, and set the same keys in Vercel for
# production (Project → Settings → Environment Variables).
#
# Launch readiness is reported at /api/health. Use empty values here; never
# commit credentials. Lead capture requires Supabase OR one alert route, though
# Supabase is required for enrollment reminders and is strongly recommended.
# =============================================================================

# --- Durable lead and reminder storage (strongly recommended) ----------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Never expose the service role key to the browser.

# --- Lead alert + prospect/reminder email ------------------------------------
# Resend provides an agent alert and prospect email. Verify the sender domain.
RESEND_API_KEY=
RESEND_FROM=
# RESEND_FROM must be on a domain you've verified with Resend, or the
# prospect auto-reply will silently fail to send.

LEAD_NOTIFY_EMAIL=

# --- REQUIRED for correct canonical URLs, sitemap, and JSON-LD ---------------
NEXT_PUBLIC_SITE_URL=
# Exact production HTTPS origin, with no path (for example: https://domain.tld).

# --- Text yourself the moment a lead lands (optional but recommended) --------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO=

# --- Ad tracking. Set before spending anything on ads ------------------------
NEXT_PUBLIC_META_PIXEL_ID=
# Server-side Lead events, so blocked browser pixels don't lose conversions.
# Meta Events Manager → Settings → Conversions API → Generate access token.
META_CAPI_ACCESS_TOKEN=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_NEXTDOOR_PIXEL_ID=

# --- Bot protection on the form (cloudflare.com → Turnstile) -----------------
# Inactive until both are set. Turn on once ads are running.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Alternate lead notification route: Make.com / Zapier -------------------
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=

# --- Daily reminder emails (Vercel Cron → /api/cron/reminders) ---------------
# Vercel sets this automatically when you add a cron in vercel.json; the route
# refuses to run without it, so it can't be triggered by anyone who finds the URL.
CRON_SECRET=
