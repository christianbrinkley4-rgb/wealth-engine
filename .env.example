# =============================================================================
# Copy to .env.local for development. Set production values in the selected
# host's environment settings (Netlify for the planned migration).
#
# Launch readiness is reported at /api/health. Use empty values here; never
# commit credentials. This is configuration status, not a live delivery test.
# Use COMMAND_CENTER_INGEST_* for the existing command center. The direct
# SUPABASE_* options below are for the separate legacy website schema.
# =============================================================================

# --- Optional legacy website storage; not the existing command-center schema -
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Never expose the service role key to the browser.

# --- Lead alert + prospect/reminder email ------------------------------------
# Resend provides an agent alert and prospect email. Verify the sender domain.
RESEND_API_KEY=
RESEND_FROM=
# RESEND_FROM must be on a domain you've verified with Resend, or the
# prospect auto-reply will silently fail to send.

LEAD_NOTIFY_EMAIL=

# --- REQUIRED for correct canonical URLs, sitemap, and JSON-LD ---------------
NEXT_PUBLIC_SITE_URL=
# Exact production HTTPS origin, with no path. A host-provided preview URL is
# not a substitute for explicitly configuring the permanent public origin.
# Public ownership-verification values from Google Search Console and Bing.
# DNS verification can be used instead. Never paste a whole HTML tag here.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Booking calendars: copy real published HTTPS event URLs from Cal.com ----
# Keep distinct services in distinct event types. No URLs are invented by code.
# An empty topic URL offers a request form unless a generic fallback is set.
NEXT_PUBLIC_SCHEDULING_MEDICARE_URL=
NEXT_PUBLIC_SCHEDULING_LIFE_INSURANCE_URL=
NEXT_PUBLIC_SCHEDULING_CARE_COVERAGE_URL=
NEXT_PUBLIC_SCHEDULING_FINANCIAL_PLANNING_URL=
# Optional explicit fallback for services without their own event URL.
NEXT_PUBLIC_SCHEDULING_URL=

# --- Cal.com appointment synchronization (server-only; optional until ready) --
# Register the deployed HTTPS /api/webhooks/cal endpoint in Cal.com with the
# same dedicated random secret (32–256 characters). Never publish this secret.
CALCOM_WEBHOOK_SECRET=
# Exact organizer email used by the connected Cal.com account.
CALCOM_ORGANIZER_EMAIL=
# JSON object mapping REAL positive numeric event IDs to these exact topics:
# medicare, life_insurance, care_coverage, financial_planning.
# The corresponding command-center appointment migration/ingress must be
# deployed too. Validate created/requested/rescheduled/cancelled/rejected events.
CALCOM_EVENT_TYPES=

# --- Text yourself the moment a lead lands (optional but recommended) --------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO=

# --- Optional ad measurement; intentionally disabled for the initial setup ---
# Leave blank until the actual data flow, permission, disclosure, and platform
# requirements are reviewed. Internal campaign attribution works without pixels.
NEXT_PUBLIC_META_PIXEL_ID=
# Server-side measurement is separate from browser tracking and contact consent.
META_CAPI_ACCESS_TOKEN=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_NEXTDOOR_PIXEL_ID=

# --- Bot protection on the form (cloudflare.com → Turnstile) -----------------
# Inactive until both are set. Configure and test before promotion.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Alternate lead notification route: Make.com / Zapier -------------------
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=

# --- Optional legacy enrollment reminders: /api/cron/reminders ---------------
# Requires the separate legacy reminder schema, Resend, and an explicitly
# connected scheduler. Set the shared secret yourself in host and scheduler.
# This is not automatically activated by Cal.com or command-center capture.
CRON_SECRET=
# Google review link used by the post-consultation review sequence
# (/api/cron/nurture). Get it from your Google Business Profile: share the
# "Ask for reviews" short link. While empty, the review sequence enrolls
# nothing and sends nothing.
GOOGLE_REVIEW_URL=
# T65 Daily Command Center (server only). Use this for the existing lead database.
# This scoped ingress can capture inquiries; it cannot download your prospect list.
COMMAND_CENTER_INGEST_URL=
COMMAND_CENTER_INGEST_KEY=
